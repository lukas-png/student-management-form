# Production environment for docker-compose.prod.yml. Copy to .env and fill in.
# NEVER commit the real .env (it is gitignored).

# Strong random secret (min 32 chars). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Public domain served by Caddy (must point to this host's public IP via DNS).
DOMAIN=planer.example.de

# Public base URL used to build magic links in outgoing mail (MUST be the public
# HTTPS domain so links work in students' inboxes).
PUBLIC_BASE_URL=https://planer.example.de

# Host NetBird overlay IP (e.g. 100.x.y.z). Admin reaches the app at
# http://<NETBIRD_IP>:8000/admin/ — only devices in your NetBird network can.
NETBIRD_IP=100.0.0.0

DATABASE_URL=sqlite:////data/planer.db
INDIVIDUAL_THRESHOLD=3
PLANNING_HORIZON_WEEKS=1
TOKEN_MAX_AGE_HOURS=168

# Logging: JSON for aggregation in production.
LOG_LEVEL=INFO
LOG_JSON=true

# Hide API docs in production
ENABLE_DOCS=false

# Admin auth: forward_auth = no app-level check (NetBird is the boundary).
ADMIN_AUTH_MODE=forward_auth
# Admin is accessed as plain HTTP over the (already encrypted) NetBird tunnel,
# so the CSRF cookie must NOT require TLS. NetBird/WireGuard provides the encryption.
COOKIE_SECURE=false

# Real SMTP for sending mail (MailHog is dev-only and not in this stack).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=tutorium@example.de
MAIL_REPLY_TO=tutorium@example.de

# stu-mgmt / Sparkyservice
STUMGMT_API_URL=https://authenticate.sse.uni-hildesheim.de/stmgmt
SPARKY_AUTH_URL=https://authenticate.sse.uni-hildesheim.de/api/v1/authenticate
SPARKY_USER=
SPARKY_PASSWORD=
STUMGMT_COURSE_ID=java-sose2026
