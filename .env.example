# Required — app won't start without this (min 32 chars)
SECRET_KEY=

DATABASE_URL=sqlite:////data/planer.db
INDIVIDUAL_THRESHOLD=3
PLANNING_HORIZON_WEEKS=1
TOKEN_MAX_AGE_HOURS=168

# Base URL used to build magic links in outgoing mail
PUBLIC_BASE_URL=http://localhost:8000

# Logging. LOG_LEVEL: DEBUG|INFO|WARNING|ERROR. LOG_JSON=true → one JSON object
# per line (for aggregation); false → human-readable text.
LOG_LEVEL=INFO
LOG_JSON=false

# Admin auth. Default forward_auth = NO app-level check (proxy/network is the
# boundary). Switch to "password" to require Argon2 HTTP Basic credentials.
ADMIN_AUTH_MODE=forward_auth
# Optional, forward_auth only: header read purely for logging the admin identity.
ADMIN_FORWARD_AUTH_HEADER=X-Authentik-Username
# Required only when ADMIN_AUTH_MODE=password (Argon2 hash).
ADMIN_PASSWORD_HASH=
# Secure flag on the CSRF cookie; set to false only for local HTTP development
COOKIE_SECURE=true

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# STARTTLS for the SMTP connection. true for real servers; false for MailHog (no TLS)
SMTP_STARTTLS=true
MAIL_FROM=
MAIL_REPLY_TO=
# Testing only: redirect ALL outgoing mail to this address (empty = normal delivery)
MAIL_OVERRIDE_TO=

# stu-mgmt API base (routes /courses/{id}/users, /groups, /admission-status appended)
STUMGMT_API_URL=https://authenticate.sse.uni-hildesheim.de/stmgmt
# Full Sparkyservice login endpoint (POST {username, password} -> JWT)
SPARKY_AUTH_URL=https://authenticate.sse.uni-hildesheim.de/api/v1/authenticate
SPARKY_USER=
SPARKY_PASSWORD=
STUMGMT_COURSE_ID=
# Write-back target for `planer sync`: the homework assignment that tracks who
# presented (mandatory pass-rule). Set the id directly, OR leave it empty and
# give the exact assignment name to resolve it via GET /assignments.
STUMGMT_PRESENTATION_ASSIGNMENT_ID=
STUMGMT_PRESENTATION_ASSIGNMENT_NAME=
# On import, a student counts as "already examined" (excluded from the due list)
# only when their presentation assessment is RELEASED (not a draft) AND reaches at
# least this many points. Drafts and lower scores keep the student due.
PRESENTATION_PASS_POINTS=1
